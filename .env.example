# Copy to .env next to the ./wob wrapper. Every value is optional.
# ./wob exports this file before running a tool; tools/_config.py reads the paths.

# Name shown in pause files, peer-read logs and the dashboard.
WOB_AGENT_NAME=

# Absolute paths. Defaults: ./vault and ./tools/.credit_ledger.json
WOB_VAULT_ROOT=
WOB_CREDIT_LEDGER=

# Paired agents only: the OTHER agent's vault/ (read-only) and its name.
WOB_PEER_VAULT=
WOB_PEER_NAME=

# Token budgets per day (defaults 2000000 and 500000).
DAILY_TOKEN_BUDGET=
NIGHTLY_TOKEN_BUDGET=
